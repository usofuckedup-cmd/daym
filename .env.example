# Postgres connection string from Neon (or any Postgres provider)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js — generate with: npx auth secret
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Stripe test mode keys — from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# From `stripe listen` (local) or your webhook endpoint settings (production)
STRIPE_WEBHOOK_SECRET="whsec_..."
