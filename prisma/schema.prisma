generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())

  stripeAccountId String?
  payoutsEnabled  Boolean @default(false)

  dealsAsBuyer  Deal[]    @relation("BuyerDeals")
  dealsAsSeller Deal[]    @relation("SellerDeals")
  messages      DealMessage[]
}

enum DealStatus {
  awaiting_payment
  in_progress
  pending_confirmation
  completed
  disputed
  cancelled
}

model Deal {
  id                     String     @id @default(cuid())
  title                  String
  description            String?
  amount                 Int // stored in cents
  currency               String     @default("usd")
  status                 DealStatus @default(awaiting_payment)

  buyerId                String
  buyer                  User       @relation("BuyerDeals", fields: [buyerId], references: [id])

  sellerId               String?
  seller                 User?      @relation("SellerDeals", fields: [sellerId], references: [id])
  sellerEmail            String?    // used to invite a seller who may not have an account yet

  stripeCheckoutSessionId String?
  stripePaymentIntentId  String?
  stripeTransferId       String?

  dueDate                DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  messages               DealMessage[]
  dispute                Dispute?
}

model DealMessage {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

enum DisputeStatus {
  open
  under_review
  resolved
}

model Dispute {
  id        String        @id @default(cuid())
  dealId    String        @unique
  deal      Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  reason    String
  status    DisputeStatus @default(open)
  createdAt DateTime      @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now())
}

